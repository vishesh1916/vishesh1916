<svg xmlns="http://www.w3.org/2000/svg"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     viewBox="0 0 1664 936"
     width="1664"
     height="936"
     preserveAspectRatio="xMidYMid meet"
     role="img"
     aria-label="Vishesh pixel art developer workspace">

  <title>Vishesh Pixel Art Workspace</title>
  <desc>
    Pixel-art developer workspace illustration used as the visual for the
    Tech Stack section of Vishesh Sachan's GitHub profile.
  </desc>

  <image
    x="0"
    y="0"
    width="1664"
    height="936"
    preserveAspectRatio="xMidYMid slice"
    href="data:image/png;base64,"
    xlink:href="data:image/png;base64,"
  />
</svg>
